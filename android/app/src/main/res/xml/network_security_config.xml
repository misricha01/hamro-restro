<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP only to the local dev API server. Android blocks
     cleartext traffic by default since API 28; everything else still
     requires HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.27</domain>
    </domain-config>
</network-security-config>
